import binascii
import os
import socket
import subprocess
import sys
import tempfile
import time

import yaml

INTERFACE = "wlan0"
CONFIG_PATH = "/etc/netplan/30-lkg-wifi.yaml"
CONTROL_PATH = "/run/wpa_supplicant/wlan0"
WPA_CONFIG_PATH = "/run/netplan/wpa-wlan0.conf"
MAX_SAVED_NETWORKS = 32
CTRL_INTERFACE_LINE = "ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev"


def wpa(*arguments):
    local_path = f"/run/lkg-wifi-{os.getpid()}"
    control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        try:
            os.unlink(local_path)
        except FileNotFoundError:
            pass
        control.bind(local_path)
        control.settimeout(15)
        control.connect(CONTROL_PATH)
        command = " ".join((arguments[0].upper(), *arguments[1:]))
        control.send(command.encode("utf-8"))
        return control.recv(65535).decode("utf-8", errors="replace").strip()
    finally:
        control.close()
        try:
            os.unlink(local_path)
        except FileNotFoundError:
            pass


class WPAControl:
    def __init__(self):
        self.local_path = f"/run/lkg-wifi-events-{os.getpid()}"
        self.control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.events = []
        try:
            try:
                os.unlink(self.local_path)
            except FileNotFoundError:
                pass
            self.control.bind(self.local_path)
            self.control.connect(CONTROL_PATH)
        except BaseException:
            self.close()
            raise

    def close(self):
        self.control.close()
        try:
            os.unlink(self.local_path)
        except FileNotFoundError:
            pass

    def receive(self, timeout):
        self.control.settimeout(max(0, timeout))
        return self.control.recv(65535).decode("utf-8", errors="replace").strip()

    def command(self, *arguments):
        deadline = time.monotonic() + 15
        command = " ".join((arguments[0].upper(), *arguments[1:]))
        self.control.send(command.encode("utf-8"))
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("wpa_supplicant command timed out")
            message = self.receive(remaining)
            if message.startswith("<"):
                self.events.append(message)
            else:
                return message

    def next_event(self, timeout):
        if self.events:
            return self.events.pop(0)
        if timeout <= 0:
            return None
        try:
            message = self.receive(timeout)
        except socket.timeout:
            return None
        return message if message.startswith("<") else None


def require_ok(output):
    if output != "OK":
        raise RuntimeError(output or "wpa_supplicant rejected the configuration")


def status_fields(control=None):
    output = control.command("status") if control else wpa("status")
    fields = {}
    for line in output.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    return fields


def parse_config_bytes(raw):
    if not raw:
        return {}
    try:
        text = raw.decode("utf-8")
        data = yaml.safe_load(text)
    except (UnicodeDecodeError, yaml.YAMLError):
        return {}
    return data if isinstance(data, dict) else {}


def read_config():
    try:
        with open(CONFIG_PATH, "rb") as source:
            return parse_config_bytes(source.read())
    except FileNotFoundError:
        return {}


def access_points(config):
    if not isinstance(config, dict):
        return {}
    network = config.get("network")
    if not isinstance(network, dict):
        return {}
    wifis = network.get("wifis")
    if not isinstance(wifis, dict):
        return {}
    interface = wifis.get(INTERFACE)
    if not isinstance(interface, dict):
        return {}
    raw_access_points = interface.get("access-points")
    if not isinstance(raw_access_points, dict):
        return {}
    result = {}
    for ssid, entry in raw_access_points.items():
        result[str(ssid)] = dict(entry) if isinstance(entry, dict) else {}
    return result


def merge_saved_network(saved, ssid, password):
    merged = dict(saved)
    merged.pop(ssid, None)
    merged[ssid] = {"password": password} if password else {}
    while len(merged) > MAX_SAVED_NETWORKS:
        oldest = next(iter(merged))
        del merged[oldest]
    return merged


def build_config(saved):
    return {
        "network": {
            "version": 2,
            "wifis": {
                INTERFACE: {
                    "dhcp4": True,
                    "access-points": dict(saved),
                }
            },
        }
    }


def quote_passphrase(password):
    if len(password) == 64 and all(c in "0123456789abcdefABCDEF" for c in password):
        return password
    return f'"{password}"'


def write_bytes_atomic(path, data, mode=0o600):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".lkg-wifi-", dir=directory, text=False)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def write_text_atomic(path, text, mode=0o600):
    write_bytes_atomic(path, text.encode("utf-8"), mode=mode)


def write_config(path, data):
    dumped = yaml.safe_dump(data, default_flow_style=False, sort_keys=False, allow_unicode=True)
    write_text_atomic(path, dumped, mode=0o600)


def decode_wpa_ssid(value):
    escapes = {
        "\\": b"\\",
        '"': b'"',
        "n": b"\n",
        "r": b"\r",
        "t": b"\t",
        "e": b"\x1b",
    }
    result = bytearray()
    index = 0
    while index < len(value):
        if value[index] == "\\" and index + 1 < len(value):
            if value[index + 1] == "x" and index + 4 <= len(value):
                try:
                    result.append(int(value[index + 2:index + 4], 16))
                    index += 4
                    continue
                except ValueError:
                    pass
            next_char = value[index + 1]
            if next_char in escapes:
                result.extend(escapes[next_char])
            else:
                result.extend(next_char.encode("utf-8"))
            index += 2
            continue
        result.extend(value[index].encode("utf-8"))
        index += 1
    return bytes(result)


def decode_wpa_conf_ssid(raw_value, known_ssids):
    raw = raw_value.strip()
    if raw.startswith('P"') and raw.endswith('"') and len(raw) >= 3:
        inner = raw[2:-1]
        try:
            return decode_wpa_ssid(inner).decode("utf-8")
        except UnicodeDecodeError:
            return None
    if raw.startswith('"') and raw.endswith('"') and len(raw) >= 2:
        inner = raw[1:-1]
        if inner in known_ssids:
            return inner
        try:
            decoded = decode_wpa_ssid(inner).decode("utf-8")
            if decoded in known_ssids:
                return decoded
        except UnicodeDecodeError:
            pass
        return inner
    if len(raw) >= 2 and len(raw) % 2 == 0 and all(c in "0123456789abcdefABCDEF" for c in raw):
        try:
            return bytes.fromhex(raw).decode("utf-8")
        except (ValueError, UnicodeDecodeError):
            return None
    return None


def patch_wpa_config(config=None, path=WPA_CONFIG_PATH):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as source:
            lines = source.readlines()
    except FileNotFoundError:
        return
    if config is None:
        config = read_config()
    priorities = {
        ssid: index + 1
        for index, ssid in enumerate(access_points(config))
    }
    output = [f"{CTRL_INTERFACE_LINE}\n"]
    in_network = False
    block_lines = []
    block_ssid = None
    for line in lines:
        stripped = line.strip()
        if not in_network:
            if stripped.startswith("ctrl_interface="):
                continue
            if stripped.replace(" ", "").replace("\t", "") == "network={":
                in_network = True
                block_lines = [line]
                block_ssid = None
                continue
            output.append(line)
        else:
            if stripped == "}":
                if block_ssid in priorities:
                    block_lines.append(f"  priority={priorities[block_ssid]}\n")
                block_lines.append(line)
                output.extend(block_lines)
                in_network = False
                block_lines = []
                block_ssid = None
                continue
            if stripped.startswith("priority="):
                continue
            if stripped.startswith("ssid="):
                block_ssid = decode_wpa_conf_ssid(stripped[5:], priorities)
            block_lines.append(line)
    if in_network:
        output.extend(block_lines)
    write_text_atomic(path, "".join(output), mode=0o600)


def generate_config(config=None):
    subprocess.run(["/usr/sbin/netplan", "generate"], check=True,
                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
    patch_wpa_config(config=config)
    subprocess.run(["/usr/bin/systemctl", "reload-or-restart", "systemd-networkd.service"],
                   check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)


def persist_network(ssid, password, previous_config):
    existing = parse_config_bytes(previous_config)
    saved = merge_saved_network(access_points(existing), ssid, password)
    config = build_config(saved)
    try:
        write_config(CONFIG_PATH, config)
        generate_config(config)
    except BaseException:
        if previous_config is None:
            try:
                os.unlink(CONFIG_PATH)
            except FileNotFoundError:
                pass
        else:
            write_bytes_atomic(CONFIG_PATH, previous_config, mode=0o600)
        subprocess.run(["/usr/sbin/netplan", "generate"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        try:
            patch_wpa_config()
        except BaseException:
            pass
        subprocess.run(["/usr/bin/systemctl", "reload-or-restart", "systemd-networkd.service"],
                       check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        raise


def connection_event_failed(event, network_id):
    if "CTRL-EVENT-SSID-TEMP-DISABLED" in event:
        return f"id={network_id}" in event.split()
    return ("CTRL-EVENT-AUTH-REJECT" in event or
            "CTRL-EVENT-ASSOC-REJECT" in event or
            "CTRL-EVENT-NETWORK-NOT-FOUND" in event)


def wait_until_connected(control, network_id):
    deadline = time.monotonic() + 30
    while True:
        current = status_fields(control)
        if current.get("id") == network_id and current.get("wpa_state") == "COMPLETED":
            return
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("Authentication timed out; check the password and signal")
        event = control.next_event(min(0.5, remaining))
        if event and connection_event_failed(event, network_id):
            raise RuntimeError("Authentication failed")


def connect(ssid, password):
    previous = status_fields()
    previous_id = previous.get("id")
    try:
        with open(CONFIG_PATH, "rb") as source:
            previous_config = source.read()
    except FileNotFoundError:
        previous_config = None

    network_id = None
    control = None
    try:
        control = WPAControl()
        require_ok(control.command("ATTACH"))
        network_id = control.command("add_network").strip()
        if not network_id.isdigit():
            raise RuntimeError("Unable to allocate a network profile")
        require_ok(control.command("set_network", network_id, "ssid", ssid.encode("utf-8").hex()))
        if password:
            require_ok(control.command("set_network", network_id, "psk", quote_passphrase(password)))
            require_ok(control.command("set_network", network_id, "key_mgmt", "WPA-PSK WPA-PSK-SHA256"))
        else:
            require_ok(control.command("set_network", network_id, "key_mgmt", "NONE"))
        require_ok(control.command("enable_network", network_id))
        require_ok(control.command("select_network", network_id))
        wait_until_connected(control, network_id)
        persist_network(ssid, password, previous_config)
        configured = control.command("list_networks")
        expected_ssid = ssid.encode("utf-8")
        for line in configured.splitlines()[1:]:
            fields = line.split("\t")
            if fields and fields[0].isdigit() and fields[0] != network_id:
                try:
                    if len(fields) >= 2 and decode_wpa_ssid(fields[1]) == expected_ssid:
                        control.command("remove_network", fields[0])
                    else:
                        control.command("disable_network", fields[0])
                except RuntimeError:
                    pass
        print("Connected and saved")
    except BaseException:
        restore = control.command if control else wpa
        if previous_id is not None:
            try:
                restore("select_network", previous_id)
            except BaseException:
                pass
        if network_id is not None and network_id.isdigit():
            try:
                restore("remove_network", network_id)
            except BaseException:
                pass
        raise
    finally:
        if control:
            control.close()


def connect_saved(ssid):
    saved = access_points(read_config())
    if ssid not in saved:
        raise RuntimeError("Network is no longer saved")
    password = (saved[ssid] or {}).get("password")
    connect(ssid, "" if password is None else str(password))


def disconnect():
    require_ok(wpa("disconnect"))
    for _ in range(30):
        if status_fields().get("wpa_state") != "COMPLETED":
            print("Disconnected")
            return
        time.sleep(0.2)
    raise RuntimeError("Disconnect timed out")


def forget(ssid):
    try:
        with open(CONFIG_PATH, "rb") as source:
            previous_config = source.read()
    except FileNotFoundError:
        previous_config = None
    config = parse_config_bytes(previous_config)
    saved = access_points(config)
    if ssid in saved:
        del saved[ssid]
        try:
            if saved:
                updated = build_config(saved)
                write_config(CONFIG_PATH, updated)
                generate_config(updated)
            else:
                try:
                    os.unlink(CONFIG_PATH)
                except FileNotFoundError:
                    pass
                generate_config({})
        except BaseException:
            if previous_config is None:
                try:
                    os.unlink(CONFIG_PATH)
                except FileNotFoundError:
                    pass
            else:
                write_bytes_atomic(CONFIG_PATH, previous_config, mode=0o600)
            subprocess.run(["/usr/sbin/netplan", "generate"], check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
            try:
                patch_wpa_config()
            except BaseException:
                pass
            subprocess.run(["/usr/bin/systemctl", "reload-or-restart", "systemd-networkd.service"],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
            raise RuntimeError("Unable to update the saved network configuration")

    expected = ssid.encode("utf-8")
    configured = wpa("list_networks")
    for line in configured.splitlines()[1:]:
        fields = line.split("\t")
        if len(fields) >= 2 and fields[0].isdigit() and decode_wpa_ssid(fields[1]) == expected:
            require_ok(wpa("remove_network", fields[0]))
    print("Network forgotten")


def main():
    if len(sys.argv) < 2:
        print("Usage: lkg-wifi list | connect SSID_HEX | connect-saved SSID_HEX | "
              "disconnect | forget SSID_HEX | prepare-wpa", file=sys.stderr)
        return 2
    action = sys.argv[1]
    try:
        if action == "list" and len(sys.argv) == 2:
            for ssid in access_points(read_config()):
                print(ssid.encode("utf-8").hex())
            return 0
        if action == "disconnect" and len(sys.argv) == 2:
            disconnect()
            return 0
        if action == "prepare-wpa" and len(sys.argv) == 2:
            patch_wpa_config()
            return 0
        if action not in ("connect", "connect-saved", "forget") or len(sys.argv) != 3:
            raise ValueError("Invalid arguments")
        ssid_bytes = binascii.unhexlify(sys.argv[2])
        if not 1 <= len(ssid_bytes) <= 32:
            raise ValueError("SSID must contain 1-32 bytes")
        ssid = ssid_bytes.decode("utf-8")
        if "\x00" in ssid:
            raise ValueError("NUL characters are not supported")
        if action == "connect":
            password = sys.stdin.readline().rstrip("\n")
            if "\x00" in password:
                raise ValueError("NUL characters are not supported")
            if password:
                valid_hex = len(password) == 64 and all(c in "0123456789abcdefABCDEF" for c in password)
                valid_passphrase = 8 <= len(password) <= 63 and all(32 <= ord(c) <= 126 for c in password)
                if not (valid_hex or valid_passphrase):
                    raise ValueError("Password must be 8-63 printable characters or 64 hex digits")
            connect(ssid, password)
        elif action == "connect-saved":
            connect_saved(ssid)
        else:
            forget(ssid)
        return 0
    except (ValueError, UnicodeError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"Wi-Fi configuration failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
