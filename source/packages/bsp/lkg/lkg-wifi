import binascii
import os
import socket
import subprocess
import sys
import tempfile
import time

import yaml

INTERFACE = "wlan0"
CONFIG_PATH = "/etc/netplan/30-lkg-wifi.yaml"
CONTROL_PATH = "/run/wpa_supplicant/wlan0"


def wpa(*arguments):
    local_path = f"/run/lkg-wifi-{os.getpid()}"
    control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        try:
            os.unlink(local_path)
        except FileNotFoundError:
            pass
        control.bind(local_path)
        control.settimeout(15)
        control.connect(CONTROL_PATH)
        command = " ".join((arguments[0].upper(), *arguments[1:]))
        control.send(command.encode("utf-8"))
        return control.recv(65535).decode("utf-8", errors="replace").strip()
    finally:
        control.close()
        try:
            os.unlink(local_path)
        except FileNotFoundError:
            pass


class WPAControl:
    def __init__(self):
        self.local_path = f"/run/lkg-wifi-events-{os.getpid()}"
        self.control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.events = []
        try:
            try:
                os.unlink(self.local_path)
            except FileNotFoundError:
                pass
            self.control.bind(self.local_path)
            self.control.connect(CONTROL_PATH)
        except BaseException:
            self.close()
            raise

    def close(self):
        self.control.close()
        try:
            os.unlink(self.local_path)
        except FileNotFoundError:
            pass

    def receive(self, timeout):
        self.control.settimeout(max(0, timeout))
        return self.control.recv(65535).decode("utf-8", errors="replace").strip()

    def command(self, *arguments):
        deadline = time.monotonic() + 15
        command = " ".join((arguments[0].upper(), *arguments[1:]))
        self.control.send(command.encode("utf-8"))
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("wpa_supplicant command timed out")
            message = self.receive(remaining)
            if message.startswith("<"):
                self.events.append(message)
            else:
                return message

    def next_event(self, timeout):
        if self.events:
            return self.events.pop(0)
        if timeout <= 0:
            return None
        try:
            message = self.receive(timeout)
        except socket.timeout:
            return None
        return message if message.startswith("<") else None


def require_ok(output):
    if output != "OK":
        raise RuntimeError(output or "wpa_supplicant rejected the configuration")


def status_fields(control=None):
    output = control.command("status") if control else wpa("status")
    fields = {}
    for line in output.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    return fields


def read_config():
    try:
        with open(CONFIG_PATH, "r") as source:
            return yaml.safe_load(source) or {}
    except FileNotFoundError:
        return {}


def access_points(config):
    return ((config.get("network", {}).get("wifis", {})
             .get(INTERFACE, {}).get("access-points", {})) or {})


def quote_passphrase(password):
    if len(password) == 64 and all(c in "0123456789abcdefABCDEF" for c in password):
        return password
    return f'"{password}"'


def write_config(path, data):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".lkg-wifi-", dir=directory, text=True)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as output:
            yaml.safe_dump(data, output, default_flow_style=False, sort_keys=False, allow_unicode=True)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def allow_menu_control():
    path = "/run/netplan/wpa-wlan0.conf"
    try:
        with open(path, "r") as source:
            lines = [line for line in source if not line.startswith("ctrl_interface=")]
    except FileNotFoundError:
        return
    lines.append("ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev\n")
    write_config(path, "".join(lines))


def generate_config():
    subprocess.run(["/usr/sbin/netplan", "generate"], check=True,
                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
    allow_menu_control()
    subprocess.run(["/usr/bin/systemctl", "reload-or-restart", "systemd-networkd.service"],
                   check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)


def persist_network(ssid, password, previous_config):
    access_point = {}
    if password:
        access_point["password"] = password
    config = {
        "network": {
            "version": 2,
            "wifis": {
                INTERFACE: {
                    "dhcp4": True,
                    "access-points": {ssid: access_point},
                }
            },
        }
    }
    try:
        write_config(CONFIG_PATH, config)
        generate_config()
    except BaseException:
        if previous_config is None:
            try:
                os.unlink(CONFIG_PATH)
            except FileNotFoundError:
                pass
        else:
            with open(CONFIG_PATH, "wb") as output:
                output.write(previous_config)
        subprocess.run(["/usr/sbin/netplan", "generate"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        allow_menu_control()
        subprocess.run(["/usr/bin/systemctl", "reload-or-restart", "systemd-networkd.service"],
                       check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        raise


def connection_event_failed(event, network_id):
    if "CTRL-EVENT-SSID-TEMP-DISABLED" in event:
        return f"id={network_id}" in event.split()
    return ("CTRL-EVENT-AUTH-REJECT" in event or
            "CTRL-EVENT-ASSOC-REJECT" in event or
            "CTRL-EVENT-NETWORK-NOT-FOUND" in event)


def wait_until_connected(control, network_id):
    deadline = time.monotonic() + 30
    while True:
        current = status_fields(control)
        if current.get("id") == network_id and current.get("wpa_state") == "COMPLETED":
            return
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("Authentication timed out; check the password and signal")
        event = control.next_event(min(0.5, remaining))
        if event and connection_event_failed(event, network_id):
            raise RuntimeError("Authentication failed")


def connect(ssid, password):
    previous = status_fields()
    previous_id = previous.get("id")
    try:
        with open(CONFIG_PATH, "rb") as source:
            previous_config = source.read()
    except FileNotFoundError:
        previous_config = None

    network_id = None
    control = None
    try:
        control = WPAControl()
        require_ok(control.command("ATTACH"))
        network_id = control.command("add_network").strip()
        if not network_id.isdigit():
            raise RuntimeError("Unable to allocate a network profile")
        require_ok(control.command("set_network", network_id, "ssid", ssid.encode("utf-8").hex()))
        if password:
            require_ok(control.command("set_network", network_id, "psk", quote_passphrase(password)))
            require_ok(control.command("set_network", network_id, "key_mgmt", "WPA-PSK WPA-PSK-SHA256"))
        else:
            require_ok(control.command("set_network", network_id, "key_mgmt", "NONE"))
        require_ok(control.command("enable_network", network_id))
        require_ok(control.command("select_network", network_id))
        wait_until_connected(control, network_id)
        persist_network(ssid, password, previous_config)
        configured = control.command("list_networks")
        for line in configured.splitlines()[1:]:
            fields = line.split("\t")
            if fields and fields[0].isdigit() and fields[0] != network_id:
                try:
                    control.command("disable_network", fields[0])
                except RuntimeError:
                    pass
        print("Connected and saved")
    except BaseException:
        restore = control.command if control else wpa
        if previous_id is not None:
            try:
                restore("select_network", previous_id)
            except BaseException:
                pass
        if network_id is not None and network_id.isdigit():
            try:
                restore("remove_network", network_id)
            except BaseException:
                pass
        raise
    finally:
        if control:
            control.close()


def connect_saved(ssid):
    access_point = access_points(read_config()).get(ssid)
    if access_point is None:
        raise RuntimeError("Network is no longer saved")
    connect(ssid, (access_point or {}).get("password", ""))


def disconnect():
    require_ok(wpa("disconnect"))
    for _ in range(30):
        if status_fields().get("wpa_state") != "COMPLETED":
            print("Disconnected")
            return
        time.sleep(0.2)
    raise RuntimeError("Disconnect timed out")


def decode_wpa_ssid(value):
    result = bytearray()
    index = 0
    while index < len(value):
        if value[index:index + 2] == "\\x" and index + 4 <= len(value):
            try:
                result.append(int(value[index + 2:index + 4], 16))
                index += 4
                continue
            except ValueError:
                pass
        result.extend(value[index].encode("utf-8"))
        index += 1
    return bytes(result)


def forget(ssid):
    config = read_config()
    saved = access_points(config)
    if ssid in saved:
        del saved[ssid]
        try:
            if saved:
                write_config(CONFIG_PATH, config)
            else:
                try:
                    os.unlink(CONFIG_PATH)
                except FileNotFoundError:
                    pass
            generate_config()
        except BaseException:
            raise RuntimeError("Unable to update the saved network configuration")

    expected = ssid.encode("utf-8")
    configured = wpa("list_networks")
    for line in configured.splitlines()[1:]:
        fields = line.split("\t")
        if len(fields) >= 2 and fields[0].isdigit() and decode_wpa_ssid(fields[1]) == expected:
            require_ok(wpa("remove_network", fields[0]))
    print("Network forgotten")


def main():
    if len(sys.argv) < 2:
        print("Usage: lkg-wifi list | connect SSID_HEX | connect-saved SSID_HEX | "
              "disconnect | forget SSID_HEX", file=sys.stderr)
        return 2
    action = sys.argv[1]
    try:
        if action == "list" and len(sys.argv) == 2:
            for ssid in access_points(read_config()):
                print(ssid.encode("utf-8").hex())
            return 0
        if action == "disconnect" and len(sys.argv) == 2:
            disconnect()
            return 0
        if action not in ("connect", "connect-saved", "forget") or len(sys.argv) != 3:
            raise ValueError("Invalid arguments")
        ssid_bytes = binascii.unhexlify(sys.argv[2])
        if not 1 <= len(ssid_bytes) <= 32:
            raise ValueError("SSID must contain 1-32 bytes")
        ssid = ssid_bytes.decode("utf-8")
        if "\x00" in ssid:
            raise ValueError("NUL characters are not supported")
        if action == "connect":
            password = sys.stdin.readline().rstrip("\n")
            if "\x00" in password:
                raise ValueError("NUL characters are not supported")
            if password:
                valid_hex = len(password) == 64 and all(c in "0123456789abcdefABCDEF" for c in password)
                valid_passphrase = 8 <= len(password) <= 63 and all(32 <= ord(c) <= 126 for c in password)
                if not (valid_hex or valid_passphrase):
                    raise ValueError("Password must be 8-63 printable characters or 64 hex digits")
            connect(ssid, password)
        elif action == "connect-saved":
            connect_saved(ssid)
        else:
            forget(ssid)
        return 0
    except (ValueError, UnicodeError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"Wi-Fi configuration failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
