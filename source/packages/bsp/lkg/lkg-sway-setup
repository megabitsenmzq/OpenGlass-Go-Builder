# 5. Virtual 1280x720@1.0 VNC display (HEADLESS-1) & wayvnc launcher
cat >/usr/local/bin/lkg-vnc <<'EOF'
#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
WAYVNC_DIR="/home/lkg/.config/wayvnc"
mkdir -p "$WAYVNC_DIR"
chmod 0700 "$WAYVNC_DIR"

if [ ! -f "$WAYVNC_DIR/rsa_key.pem" ]; then
    openssl genrsa -traditional -out "$WAYVNC_DIR/rsa_key.pem" 2048 2>/dev/null
    chmod 0600 "$WAYVNC_DIR/rsa_key.pem"
fi
if [ ! -f "$WAYVNC_DIR/tls_key.pem" ] || [ ! -f "$WAYVNC_DIR/tls_cert.pem" ]; then
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "$WAYVNC_DIR/tls_key.pem" \
        -out "$WAYVNC_DIR/tls_cert.pem" \
        -days 3650 -subj "/CN=lkg.local" 2>/dev/null
    chmod 0600 "$WAYVNC_DIR/tls_key.pem" "$WAYVNC_DIR/tls_cert.pem"
fi

if [ -z "${SWAYSOCK:-}" ]; then
    SWAY_PID="$(pidof sway | awk '{print $1}')"
    if [ -n "$SWAY_PID" ] && [ -S "$XDG_RUNTIME_DIR/sway-ipc.1000.$SWAY_PID.sock" ]; then
        export SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.1000.$SWAY_PID.sock"
    fi
fi

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
        case "$sock" in
            *.lock) continue ;;
        esac
        if [ -S "$sock" ]; then
            export WAYLAND_DISPLAY="$(basename "$sock")"
            break
        fi
    done
fi

i=0
while [ $i -lt 30 ]; do
    if swaymsg -t get_outputs >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
    i=$((i + 1))
done

if ! swaymsg -t get_outputs | grep -q '"name": "HEADLESS-1"'; then
    swaymsg create_output >/dev/null 2>&1 || true
    sleep 0.2
fi

swaymsg 'output HEADLESS-1 resolution 1280x720 position 360 0 scale 1.0 bg #12151c solid_color' >/dev/null 2>&1 || true
swaymsg 'workspace number 2; move workspace to output HEADLESS-1; workspace number 1' >/dev/null 2>&1 || true

if ! pgrep -x wayvnc >/dev/null 2>&1; then
    exec wayvnc --gpu --output=HEADLESS-1 --max-fps=30 0.0.0.0 5900
fi
EOF
chmod 0755 /usr/local/bin/lkg-vnc

