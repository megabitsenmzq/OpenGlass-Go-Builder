# 2. Native PipeWire volume helper (wpctl + compact mako progress bubble + tiny popup menu)
cat >/usr/local/bin/lkg-volume <<'EOF'
#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

show_bubble() {
    out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo 'Volume: 0.00')"
    pct="$(printf '%s\n' "$out" | awk '{printf "%d", $2 * 100 + 0.5}')"
    case "$out" in
        *MUTED*)
            notify-send -t 1400 \
                -h string:x-canonical-private-synchronous:volume \
                -h int:value:0 \
                "Volume: Muted (${pct}%)"
            ;;
        *)
            notify-send -t 1400 \
                -h string:x-canonical-private-synchronous:volume \
                -h int:value:"$pct" \
                "Volume: ${pct}%"
            ;;
    esac
}

case "${1:-}" in
    up)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        show_bubble
        ;;
    down)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
        show_bubble
        ;;
    mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        show_bubble
        ;;
    popup)
        if pkill -x fuzzel 2>/dev/null; then
            exit 0
        fi
        out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo 'Volume: 0.00')"
        pct="$(printf '%s\n' "$out" | awk '{printf "%d", $2 * 100 + 0.5}')"
        choice="$(printf '+10%%\n-10%%\nMute / Unmute\n100%%\n80%%\n60%%\n40%%\n20%%\n' | \
            fuzzel --dmenu \
                --anchor=top-right \
                --x-margin=10 \
                --y-margin=6 \
                --width=13 \
                --lines=8 \
                --prompt="Vol ${pct}% > ")" || exit 0
        case "$choice" in
            "+10%")
                wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
                wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+
                ;;
            "-10%")
                wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%-
                ;;
            "Mute / Unmute")
                wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
                ;;
            100%|80%|60%|40%|20%)
                wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
                wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$choice"
                ;;
            *)
                exit 0
                ;;
        esac
        show_bubble
        ;;
    *)
        show_bubble
        ;;
esac
EOF
chmod 0755 /usr/local/bin/lkg-volume

