[Unit]
Description=Initialize LKG Go STM32 and read calibration
Before=lkg-menu.service

[Service]
Type=oneshot
User=lkg
Group=lkg
SupplementaryGroups=dialout
RuntimeDirectory=lkg
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/lkg-mcu init --output /run/lkg/visual.json --template /etc/lkg/visual-template.json
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
